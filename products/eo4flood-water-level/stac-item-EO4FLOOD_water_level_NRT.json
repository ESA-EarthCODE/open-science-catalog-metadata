  "properties": {
    "title": "EO4FLOOD actual and synthetic NRT water level time series",
    "license": "CC-BY-4.0",
    "description": "Combined EO4FLOOD near-real-time (NRT) water level time series across multiple river basins. The Parquet file contains 73,246 observations at 616 DAHITI virtual stations: 7,463 Actual observations and 65,783 Synthetic observations, distinguished by nrt_type. Actual NRT records are available for Niger basin sites; Synthetic records cover sites from all nine EO4FLOOD basin deliveries and were generated from DAHITI observations by adding bias and noise. date records observation timestamps in UTC, wse is water surface elevation in metres, and wse_u is uncertainty in metres, available only for Actual records. dahiti_id identifies the virtual station; lon and lat locate it in geographic degrees. Source dataset, mission, institution and simulation provenance are retained in the table.",
    "datetime": null,
    "start_datetime": "1993-11-04T10:50:26Z",
    "end_datetime": "2025-12-02T20:40:49Z",
    "providers": [
      {
